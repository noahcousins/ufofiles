{
  "name": "ufofiles",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --fix .",
    "check": "tsc --noEmit",
    "clean": "rimraf node_modules pnpm-lock.yaml dist .turbo .cache .pnpm-store && pnpm -r exec rimraf node_modules dist .turbo .next .cache",
    "clean:deep": "pnpm store prune && pnpm run clean",
    "email:dev": "email dev --dir emails --port 3030",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env.local scripts/seed-db.mts",
    "db:studio": "drizzle-kit studio",
    "db:import-transcripts": "tsx --env-file=.env.local scripts/import-transcripts.ts",
    "db:populate-moments": "tsx --env-file=.env.local scripts/populate-video-moments.ts",
    "scrape:extract-ocr": "tsx --env-file=.env.local scripts/scrape/13-extract-pdf-ocr.ts",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "trigger:dev": "pnpm dlx trigger.dev@latest dev",
    "trigger:deploy": "trigger deploy",
    "scrape": "tsx --env-file=.env.local scripts/scrape/run-all.ts",
    "scrape:csv": "tsx --env-file=.env.local scripts/scrape/01-fetch-csv.ts",
    "scrape:parse": "tsx --env-file=.env.local scripts/scrape/02-parse-csv.ts",
    "scrape:docs": "tsx --env-file=.env.local scripts/scrape/03-download-docs.ts",
    "scrape:videos": "tsx --env-file=.env.local scripts/scrape/04-download-videos.ts",
    "scrape:pdf-previews": "tsx --env-file=.env.local scripts/scrape/05-generate-pdf-previews.ts",
    "scrape:pdf-text": "tsx --env-file=.env.local scripts/scrape/06-extract-pdf-text.ts",
    "scrape:video-previews": "tsx --env-file=.env.local scripts/scrape/07-generate-video-previews.ts",
    "scrape:card-thumbs": "tsx --env-file=.env.local scripts/scrape/08-generate-card-thumbs.ts",
    "scrape:transcode": "tsx --env-file=.env.local scripts/scrape/09-transcode-videos.ts",
    "scrape:upload": "tsx --env-file=.env.local scripts/scrape/10-upload-source-to-r2.ts",
    "scrape:upload-assets": "tsx --env-file=.env.local scripts/scrape/11-upload-assets-to-r2.ts",
    "scrape:link": "tsx --env-file=.env.local scripts/scrape/12-link-db-records.ts",
    "scrape:fix-video-types": "tsx --env-file=.env.local scripts/scrape/fix-video-types.ts",
    "scrape:upload-downloads": "tsx --env-file=.env.local scripts/scrape/upload-downloads-to-r2.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/lib-storage": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "3.1045.0",
    "@base-ui/react": "^1.4.1",
    "@c15t/nextjs": "^2.1.0",
    "@google/genai": "^2.8.0",
    "@hugeicons/core-free-icons": "^4.1.2",
    "@hugeicons/react": "^1.1.6",
    "@number-flow/react": "^0.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@tanstack/react-query": "^5.100.9",
    "@trigger.dev/sdk": "4.4.6",
    "@trpc/client": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "@upstash/redis": "^1.38.0",
    "better-auth": "^1.6.16",
    "boring-avatars": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "disposable-email-domains": "^1.0.62",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "hls.js": "^1.6.16",
    "input-otp": "^1.4.2",
    "motion": "^12.38.0",
    "next": "16.1.7",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.9",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.9",
    "posthog-js": "^1.372.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.12.4",
    "shadcn": "^4.7.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@cloudflare/workers-types": "^4.20260508.1",
    "@playwright/test": "^1.61.0",
    "@react-email/ui": "^6.6.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@trigger.dev/build": "4.4.6",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.5.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.59.1",
    "postcss": "^8",
    "react-email": "^6.6.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "ultracite": "^7.6.5",
    "wrangler": "^4.90.0"
  }
}
