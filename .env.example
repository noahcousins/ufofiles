DATABASE_URL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SOURCE_BUCKET_NAME=
R2_ASSETS_BUCKET_NAME=
R2_DOWNLOADS_BUCKET_NAME=
# Private bucket for rendered clips (ADR-0002). Never served by the Worker —
# delivery is via short-lived presigned URLs only.
R2_CLIPS_BUCKET_NAME=
# legacy bucket, remove after migration is complete
R2_BUCKET_NAME=

# Clip rendering (ADR-0002). trigger.dev runs the ffmpeg cut jobs. Without
# these, clip creation still works — renders just stay pending until enqueue
# can reach trigger.dev. The render task ALSO needs DATABASE_URL + the R2_*
# vars set in the trigger.dev dashboard environment.
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_WORKER_URL=

# Auth (better-auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional — the "Continue with Google" button only shows when
# both are set). Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic-link delivery (optional — without RESEND_API_KEY the link is logged to
# the server console instead of emailed, which is enough for local dev).
RESEND_API_KEY=
EMAIL_FROM="example <noreply@t.example.com>"

# Cloudflare Turnstile (optional — guards the email/password + magic-link auth
# endpoints against bots). Only enforced when BOTH are set; the anonymous Guest
# mint is never gated. Get keys at dash.cloudflare.com → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
